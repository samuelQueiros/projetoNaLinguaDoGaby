# Copie para .env (não versionado) e ajuste os valores para o seu ambiente local.
POSTGRES_USER=erp
POSTGRES_PASSWORD=changeme-local-dev
POSTGRES_DB=erp_financeiro

# Chave AES-256 (base64) usada para criptografar dados sensíveis no banco.
# Gere uma nova por ambiente, ex: openssl rand -base64 32
CRIPTOGRAFIA_CHAVE_AES256_BASE64=

# Modo do leitor de documentos (Stub | Http) e token compartilhado com o
# servico-documentos, se ele exigir autenticação interna.
IA_LEITOR_MODO=Stub
IA_LEITOR_TOKEN_INTERNO=
