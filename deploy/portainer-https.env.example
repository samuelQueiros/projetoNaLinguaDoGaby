# Preencha uma cópia chamada deploy/portainer-https.env e carregue no Portainer.
ERP_DOMAIN=financeiro.seudominio.com.br
ERP_WEB_IMAGE=erp-financeiro-web:1.0.0
ERP_DOCUMENTOS_IMAGE=erp-financeiro-documentos:1.0.0
POSTGRES_PASSWORD=
AES_KEY_BASE64=
ADMIN_EMAIL=
ADMIN_PASSWORD=
INTERNAL_TOKEN=

# Chat e leitura de documentos — opcionais. Provedor: Gemini | OpenAi | Anthropic.
CHAT_IA_PROVEDOR=Gemini
CHAT_IA_MODELO=gemini-2.5-flash
CHAT_IA_API_KEY=
DOCUMENTOS_IA_PROVEDOR=Gemini
DOCUMENTOS_IA_MODELO=gemini-2.5-flash
DOCUMENTOS_IA_API_KEY=
# Se houver conflito de sub-rede, altere os três valores mantendo o IP dentro da rede.
PROXY_SUBNET=172.30.80.0/24
PROXY_IP=172.30.80.2
WEB_IP=172.30.80.3
