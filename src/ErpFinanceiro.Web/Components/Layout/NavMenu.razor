@implements IDisposable
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <img src="img/onrtdpj-icone.png" alt="ONRTDPJ" class="marca-logo" />
            <span>Financeiro <strong>ONRTDPJ</strong></span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-grupo">
            <div class="nav-grupo-titulo">Painel</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Início
                </NavLink>
            </div>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-grupo">
                    <div class="nav-grupo-titulo">Financeiro</div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="contas-a-pagar">
                            <span class="bi bi-wallet2-fill-nav-menu" aria-hidden="true"></span> Contas a Pagar
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="boletos">
                            <span class="bi bi-upc-nav-menu" aria-hidden="true"></span> Boletos
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="notas-fiscais">
                            <span class="bi bi-file-text-fill-nav-menu" aria-hidden="true"></span> Notas Fiscais
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="relatorios">
                            <span class="bi bi-bar-chart-fill-nav-menu" aria-hidden="true"></span> Relatórios
                        </NavLink>
                    </div>
                </div>

                <div class="nav-grupo">
                    <div class="nav-grupo-titulo">Cadastros</div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="fornecedores">
                            <span class="bi bi-building-fill-nav-menu" aria-hidden="true"></span> Fornecedores
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="contas-bancarias">
                            <span class="bi bi-bank-nav-menu" aria-hidden="true"></span> Contas Bancárias
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="cartoes">
                            <span class="bi bi-credit-card-fill-nav-menu" aria-hidden="true"></span> Cartões
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="categorias">
                            <span class="bi bi-tag-fill-nav-menu" aria-hidden="true"></span> Categorias
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="centros-de-custo">
                            <span class="bi bi-layers-fill-nav-menu" aria-hidden="true"></span> Centros de Custo
                        </NavLink>
                    </div>
                </div>

                <div class="nav-grupo">
                    <div class="nav-grupo-titulo">Documentos</div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link nav-link--ia" href="central-de-documentos" title="Leitura dos documentos feita por IA">
                            <span class="bi bi-inbox-fill-nav-menu" aria-hidden="true"></span>
                            <span class="nav-link__texto">Central de Documentos</span>
                            <span class="ponto-ia" aria-hidden="true"></span>
                        </NavLink>
                    </div>
                </div>

                <AuthorizeView Roles="Administrador" Context="adminContext">
                    <Authorized>
                        <div class="nav-grupo">
                            <div class="nav-grupo-titulo">Administração</div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="auditoria">
                                    <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> Auditoria
                                </NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="usuarios">
                                    <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Usuários
                                </NavLink>
                            </div>
                            <div class="nav-item px-3">
                                <NavLink class="nav-link" href="configuracoes-ia">
                                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Configurações de IA
                                </NavLink>
                            </div>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <div class="nav-grupo">
                    <div class="nav-grupo-titulo">Conta</div>
                    <div class="nav-item px-3">
                        <span class="nav-link" style="cursor:default;">
                            <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                        </span>
                    </div>
                    <div class="nav-item px-3">
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit" class="nav-link">
                                <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Sair
                            </button>
                        </form>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Entrar
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
