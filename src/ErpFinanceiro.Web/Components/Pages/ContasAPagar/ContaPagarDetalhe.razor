@page "/contas-a-pagar/novo"
@page "/contas-a-pagar/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using ErpFinanceiro.Application.Cartoes
@using ErpFinanceiro.Application.Categorias
@using ErpFinanceiro.Application.ContasAPagar
@using ErpFinanceiro.Application.Fornecedores
@using ErpFinanceiro.Domain
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject IGerenciadorContasPagar Gerenciador
@inject IGerenciadorFornecedores GerenciadorFornecedores
@inject IGerenciadorCadastroSimples<Categoria> GerenciadorCategorias
@inject IGerenciadorCadastroSimples<CentroCusto> GerenciadorCentrosCusto
@inject IGerenciadorCadastroSimples<FormaPagamento> GerenciadorFormasPagamento
@inject IGerenciadorContasBancariasEmpresa GerenciadorContasBancarias
@inject IGerenciadorCartoes GerenciadorCartoes
@inject IFluxoAprovacao FluxoAprovacao
@inject IGerenciadorPagamentos GerenciadorPagamentos
@inject UserManager<Usuario> UserManager
@inject NavigationManager NavigationManager

<PageTitle>@(EhNovo ? "Nova conta a pagar" : "Conta a pagar")</PageTitle>

<h1>@(EhNovo ? "Nova conta a pagar" : conta?.Descricao)</h1>

@if (!EhNovo && conta is null)
{
    <p><em>Carregando...</em></p>
}
else if (carregado)
{
    <div class="card" style="max-width: 42rem;">
        <div class="card-body">
            <EditForm Model="modelo" OnValidSubmit="TentarSalvarAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="mb-2">
                    <label class="form-label">Fornecedor</label>
                    <InputSelect class="form-select" @bind-Value="modelo.FornecedorId">
                        <option value="">—</option>
                        @foreach (var f in fornecedores)
                        {
                            <option value="@f.Id">@f.RazaoSocial</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-2">
                    <label class="form-label">Descrição</label>
                    <InputText class="form-control" @bind-Value="modelo.Descricao" />
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="form-label">Categoria</label>
                        <InputSelect class="form-select" @bind-Value="modelo.CategoriaId">
                            <option value="">—</option>
                            @foreach (var c in categorias)
                            {
                                <option value="@c.Id">@c.Nome</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Centro de custo</label>
                        <InputSelect class="form-select" @bind-Value="modelo.CentroCustoId">
                            <option value="">—</option>
                            @foreach (var c in centrosCusto)
                            {
                                <option value="@c.Id">@c.Nome</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <label class="form-label">Vencimento</label>
                        <InputDate class="form-control" @bind-Value="modelo.Vencimento" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Valor original</label>
                        <InputNumber class="form-control" @bind-Value="modelo.ValorOriginal" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Forma de pagamento</label>
                        <InputSelect class="form-select" @bind-Value="modelo.FormaPagamentoId">
                            <option value="">—</option>
                            @foreach (var f in formasPagamento)
                            {
                                <option value="@f.Id">@f.Nome</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <label class="form-label">Desconto</label>
                        <InputNumber class="form-control" @bind-Value="modelo.Desconto" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Juros</label>
                        <InputNumber class="form-control" @bind-Value="modelo.Juros" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Multa</label>
                        <InputNumber class="form-control" @bind-Value="modelo.Multa" />
                    </div>
                </div>

                <p class="fw-bold">Valor final (previsto): @ValorFinalPrevisto.ToString("C")</p>

                @if (!string.IsNullOrEmpty(erro))
                {
                    <div class="alert alert-danger">@erro</div>
                }

                <button type="submit" class="btn btn-primary">Salvar</button>
                <button type="button" class="btn btn-link" @onclick="Voltar">Voltar</button>
                @if (!EhNovo)
                {
                    <button type="button" class="btn btn-outline-danger float-end" @onclick="PedirConfirmacaoExclusao">Excluir</button>
                }
            </EditForm>
        </div>
    </div>
}

@if (!EhNovo && conta is not null)
{
    <div class="card mt-3" style="max-width: 42rem;">
        <div class="card-body">
            <h3>Aprovação</h3>
            <p>
                Status: <span class="badge bg-info text-dark">@conta.StatusAprovacao</span>
                — Financeiro: <span class="badge bg-secondary">@conta.StatusFinanceiro</span>
            </p>

            @if (!string.IsNullOrEmpty(conta.MotivoCancelamentoRejeicao))
            {
                <div class="alert alert-warning">Motivo da rejeição: @conta.MotivoCancelamentoRejeicao</div>
            }

            <AuthorizeView Roles="Gestor,Administrador">
                <Authorized>
                    @if (conta.StatusAprovacao is StatusAprovacao.Cadastrada or StatusAprovacao.AguardandoAprovacao)
                    {
                        @if (!string.IsNullOrEmpty(erroAprovacao))
                        {
                            <div class="alert alert-danger">@erroAprovacao</div>
                        }
                        <button class="btn btn-success" @onclick="AprovarAsync">Aprovar</button>
                        <button class="btn btn-outline-danger" @onclick="() => formularioRejeicaoAberto = true">Rejeitar</button>

                        @if (formularioRejeicaoAberto)
                        {
                            <div class="mt-2">
                                <label class="form-label">Motivo da rejeição</label>
                                <textarea class="form-control mb-2" @bind="motivoRejeicao"></textarea>
                                <button class="btn btn-danger btn-sm" @onclick="RejeitarAsync">Confirmar rejeição</button>
                                <button class="btn btn-link btn-sm" @onclick="() => formularioRejeicaoAberto = false">Cancelar</button>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Nenhuma ação de aprovação pendente.</p>
                    }
                </Authorized>
                <NotAuthorized>
                    <p class="text-muted">Só Gestor ou Administrador podem aprovar/rejeitar contas.</p>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>

    @if (conta.StatusAprovacao == StatusAprovacao.Aprovada)
    {
        <div class="card mt-3" style="max-width: 42rem;">
            <div class="card-body">
                <h3>Pagamentos</h3>
                <table class="table table-sm">
                    <thead>
                        <tr><th>Data</th><th>Valor</th><th>Origem</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in pagamentos)
                        {
                            <tr>
                                <td>@p.Data.ToString("dd/MM/yyyy")</td>
                                <td>@p.ValorPago.ToString("C")</td>
                                <td>@(p.ContaBancariaEmpresa?.Apelido ?? p.Cartao?.Apelido)</td>
                                <td>@p.Status</td>
                                <td>
                                    @if (p.Status == StatusPagamento.Confirmado)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => PedirConfirmacaoEstorno(p)">Estornar</button>
                                    }
                                </td>
                            </tr>
                        }
                        @if (pagamentos.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted">Nenhum pagamento registrado.</td></tr>
                        }
                    </tbody>
                </table>

                <p><strong>Total pago:</strong> @pagamentos.Where(p => p.Status == StatusPagamento.Confirmado).Sum(p => p.ValorPago).ToString("C")
                    de @conta.ValorFinal.ToString("C")</p>

                @if (!formularioPagamentoAberto)
                {
                    <button class="btn btn-outline-primary" @onclick="() => formularioPagamentoAberto = true">+ Registrar pagamento</button>
                }
                else
                {
                    <div class="border rounded p-3">
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label">Data</label>
                                <input type="date" class="form-control" @bind="modeloPagamento.Data" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Valor pago</label>
                                <input type="number" step="any" class="form-control" @bind="modeloPagamento.ValorPago" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Origem</label>
                                <select class="form-select" @bind="modeloPagamento.OrigemId">
                                    <option value="">—</option>
                                    @foreach (var cb in contasBancarias)
                                    {
                                        <option value="conta:@cb.Id">Conta: @cb.Apelido</option>
                                    }
                                    @foreach (var ct in cartoes)
                                    {
                                        <option value="cartao:@ct.Id">Cartão: @ct.Apelido</option>
                                    }
                                </select>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(erroPagamento))
                        {
                            <div class="alert alert-danger">@erroPagamento</div>
                        }
                        <button class="btn btn-primary btn-sm" @onclick="RegistrarPagamentoAsync">Salvar pagamento</button>
                        <button class="btn btn-link btn-sm" @onclick="() => formularioPagamentoAberto = false">Cancelar</button>
                    </div>
                }
            </div>
        </div>
    }

    <div class="mt-3" style="max-width: 42rem;">
        <h3>Histórico financeiro</h3>
        <p class="text-muted">
            Timeline completa disponível a partir do módulo de auditoria (Passo 22).
        </p>
    </div>
}

@if (confirmacaoEstornoVisivel)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title">Estornar pagamento</h5></div>
                <div class="modal-body">
                    <p>Informe o motivo do estorno:</p>
                    <textarea class="form-control" @bind="motivoEstorno"></textarea>
                    @if (!string.IsNullOrEmpty(erroEstorno))
                    {
                        <div class="alert alert-danger mt-2">@erroEstorno</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => confirmacaoEstornoVisivel = false">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmarEstornoAsync">Confirmar estorno</button>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmacaoModal Visivel="confirmacaoEdicaoVisivel"
                  Titulo="Confirmar alteração crítica"
                  Mensagem="Você está alterando o fornecedor, o valor original ou o vencimento desta conta — uma ação crítica (seção 8 do CLAUDE.md). Confirma a alteração?"
                  OnConfirmar="ConfirmarEdicaoAsync"
                  OnCancelar="() => confirmacaoEdicaoVisivel = false" />

<ConfirmacaoModal Visivel="confirmacaoExclusaoVisivel"
                  Titulo="Excluir conta a pagar"
                  Mensagem="Tem certeza que deseja excluir esta conta? Ela deixará de aparecer nas listagens, mas o registro é mantido (exclusão lógica)."
                  OnConfirmar="ConfirmarExclusaoAsync"
                  OnCancelar="() => confirmacaoExclusaoVisivel = false" />

@code {
    [Parameter]
    public Guid? Id { get; set; }

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    private bool EhNovo => Id is null;
    private bool carregado;

    private ContaPagar? conta;
    private List<Fornecedor> fornecedores = new();
    private List<Categoria> categorias = new();
    private List<CentroCusto> centrosCusto = new();
    private List<FormaPagamento> formasPagamento = new();
    private FormularioModelo modelo = new();
    private FormularioModelo? valoresOriginaisCarregados;
    private string? erro;
    private Guid usuarioId;

    private bool confirmacaoEdicaoVisivel;
    private bool confirmacaoExclusaoVisivel;

    private List<ContaBancariaEmpresa> contasBancarias = new();
    private List<Cartao> cartoes = new();
    private List<Pagamento> pagamentos = new();

    private string? erroAprovacao;
    private bool formularioRejeicaoAberto;
    private string motivoRejeicao = "";

    private bool formularioPagamentoAberto;
    private string? erroPagamento;
    private FormularioPagamentoModelo modeloPagamento = new();

    private bool confirmacaoEstornoVisivel;
    private string motivoEstorno = "";
    private string? erroEstorno;
    private Pagamento? pagamentoParaEstornar;

    private decimal ValorFinalPrevisto => ErpFinanceiro.Application.ContasAPagar.CalculadoraValorFinal.Calcular(
        modelo.ValorOriginal, modelo.Desconto, modelo.Juros, modelo.Multa);

    protected override async Task OnInitializedAsync()
    {
        var authState = await (AuthState ?? Task.FromResult(new Microsoft.AspNetCore.Components.Authorization.AuthenticationState(new ClaimsPrincipal())));
        var usuario = await UserManager.GetUserAsync(authState.User);
        usuarioId = usuario?.Id ?? Guid.Empty;

        fornecedores = (await GerenciadorFornecedores.ListarAsync()).ToList();
        categorias = (await GerenciadorCategorias.ListarAsync(apenasAtivos: true)).ToList();
        centrosCusto = (await GerenciadorCentrosCusto.ListarAsync(apenasAtivos: true)).ToList();
        formasPagamento = (await GerenciadorFormasPagamento.ListarAsync(apenasAtivos: true)).ToList();

        if (!EhNovo)
        {
            await RecarregarContaAsync();
            contasBancarias = (await GerenciadorContasBancarias.ListarAsync(apenasAtivas: true)).ToList();
            cartoes = (await GerenciadorCartoes.ListarAsync()).ToList();
        }

        carregado = true;
    }

    private async Task RecarregarContaAsync()
    {
        conta = await Gerenciador.ObterAsync(Id!.Value);
        if (conta is not null)
        {
            modelo = ModeloDe(conta);
            valoresOriginaisCarregados = ModeloDe(conta);
            pagamentos = (await GerenciadorPagamentos.ListarPorContaAsync(conta.Id)).ToList();
        }
    }

    private async Task AprovarAsync()
    {
        erroAprovacao = null;
        var resultado = await FluxoAprovacao.AprovarAsync(Id!.Value, usuarioId);
        if (!resultado.Sucesso)
        {
            erroAprovacao = string.Join("; ", resultado.Erros);
            return;
        }

        await RecarregarContaAsync();
    }

    private async Task RejeitarAsync()
    {
        erroAprovacao = null;
        var resultado = await FluxoAprovacao.RejeitarAsync(Id!.Value, usuarioId, motivoRejeicao);
        if (!resultado.Sucesso)
        {
            erroAprovacao = string.Join("; ", resultado.Erros);
            return;
        }

        formularioRejeicaoAberto = false;
        motivoRejeicao = "";
        await RecarregarContaAsync();
    }

    private async Task RegistrarPagamentoAsync()
    {
        erroPagamento = null;
        if (string.IsNullOrWhiteSpace(modeloPagamento.OrigemId))
        {
            erroPagamento = "Selecione a conta bancária ou o cartão de origem.";
            return;
        }

        var partes = modeloPagamento.OrigemId.Split(':');
        Guid? contaBancariaId = partes[0] == "conta" ? Guid.Parse(partes[1]) : null;
        Guid? cartaoId = partes[0] == "cartao" ? Guid.Parse(partes[1]) : null;

        var input = new RegistrarPagamentoInput(
            DateOnly.FromDateTime(modeloPagamento.Data), modeloPagamento.ValorPago, null, contaBancariaId, cartaoId);

        var resultado = await GerenciadorPagamentos.RegistrarAsync(Id!.Value, input, usuarioId);
        if (!resultado.Sucesso)
        {
            erroPagamento = string.Join("; ", resultado.Erros);
            return;
        }

        formularioPagamentoAberto = false;
        modeloPagamento = new FormularioPagamentoModelo();
        await RecarregarContaAsync();
    }

    private void PedirConfirmacaoEstorno(Pagamento p)
    {
        pagamentoParaEstornar = p;
        motivoEstorno = "";
        erroEstorno = null;
        confirmacaoEstornoVisivel = true;
    }

    private async Task ConfirmarEstornoAsync()
    {
        erroEstorno = null;
        var resultado = await GerenciadorPagamentos.EstornarAsync(pagamentoParaEstornar!.Id, motivoEstorno, usuarioId);
        if (!resultado.Sucesso)
        {
            erroEstorno = string.Join("; ", resultado.Erros);
            return;
        }

        confirmacaoEstornoVisivel = false;
        await RecarregarContaAsync();
    }

    private static FormularioModelo ModeloDe(ContaPagar c) => new()
    {
        FornecedorId = c.FornecedorId.ToString(),
        Descricao = c.Descricao,
        CategoriaId = c.CategoriaId?.ToString() ?? "",
        CentroCustoId = c.CentroCustoId?.ToString() ?? "",
        Vencimento = c.Vencimento.ToDateTime(TimeOnly.MinValue),
        ValorOriginal = c.ValorOriginal,
        Desconto = c.Desconto,
        Juros = c.Juros,
        Multa = c.Multa,
        FormaPagamentoId = c.FormaPagamentoId?.ToString() ?? "",
    };

    private bool AlteracaoCritica() =>
        valoresOriginaisCarregados is not null &&
        (valoresOriginaisCarregados.FornecedorId != modelo.FornecedorId ||
         valoresOriginaisCarregados.ValorOriginal != modelo.ValorOriginal ||
         valoresOriginaisCarregados.Vencimento != modelo.Vencimento);

    private async Task TentarSalvarAsync()
    {
        erro = null;

        if (!EhNovo && AlteracaoCritica())
        {
            confirmacaoEdicaoVisivel = true;
            return;
        }

        await SalvarAsync();
    }

    private async Task ConfirmarEdicaoAsync()
    {
        confirmacaoEdicaoVisivel = false;
        await SalvarAsync();
    }

    private async Task SalvarAsync()
    {
        var input = new ContaPagarInput(
            Guid.Parse(modelo.FornecedorId),
            modelo.Descricao,
            string.IsNullOrWhiteSpace(modelo.CategoriaId) ? null : Guid.Parse(modelo.CategoriaId),
            string.IsNullOrWhiteSpace(modelo.CentroCustoId) ? null : Guid.Parse(modelo.CentroCustoId),
            DateOnly.FromDateTime(modelo.Vencimento),
            modelo.ValorOriginal,
            modelo.Desconto,
            modelo.Juros,
            modelo.Multa,
            string.IsNullOrWhiteSpace(modelo.FormaPagamentoId) ? null : Guid.Parse(modelo.FormaPagamentoId));

        if (EhNovo)
        {
            var resultado = await Gerenciador.CriarAsync(input, usuarioId);
            if (!resultado.Operacao.Sucesso)
            {
                erro = string.Join("; ", resultado.Operacao.Erros);
                return;
            }

            NavigationManager.NavigateTo($"/contas-a-pagar/{resultado.Conta!.Id}");
        }
        else
        {
            var resultado = await Gerenciador.EditarAsync(Id!.Value, input, usuarioId);
            if (!resultado.Sucesso)
            {
                erro = string.Join("; ", resultado.Erros);
                return;
            }

            conta = await Gerenciador.ObterAsync(Id!.Value);
            modelo = ModeloDe(conta!);
            valoresOriginaisCarregados = ModeloDe(conta!);
        }
    }

    private void PedirConfirmacaoExclusao() => confirmacaoExclusaoVisivel = true;

    private async Task ConfirmarExclusaoAsync()
    {
        confirmacaoExclusaoVisivel = false;
        await Gerenciador.ExcluirAsync(Id!.Value, usuarioId);
        NavigationManager.NavigateTo("/contas-a-pagar");
    }

    private void Voltar() => NavigationManager.NavigateTo("/contas-a-pagar");

    private sealed class FormularioModelo
    {
        [Required(ErrorMessage = "Selecione o fornecedor.")]
        public string FornecedorId { get; set; } = "";

        [Required(ErrorMessage = "Informe a descrição.")]
        public string Descricao { get; set; } = "";

        public string CategoriaId { get; set; } = "";
        public string CentroCustoId { get; set; } = "";
        public DateTime Vencimento { get; set; } = DateTime.Today.AddDays(30);

        [Range(0, double.MaxValue, ErrorMessage = "Valor original não pode ser negativo.")]
        public decimal ValorOriginal { get; set; }

        [Range(0, double.MaxValue)]
        public decimal Desconto { get; set; }

        [Range(0, double.MaxValue)]
        public decimal Juros { get; set; }

        [Range(0, double.MaxValue)]
        public decimal Multa { get; set; }

        public string FormaPagamentoId { get; set; } = "";
    }

    private sealed class FormularioPagamentoModelo
    {
        public DateTime Data { get; set; } = DateTime.Today;
        public decimal ValorPago { get; set; }
        public string OrigemId { get; set; } = "";
    }
}
