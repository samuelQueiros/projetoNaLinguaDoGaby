@page "/relatorios"
@attribute [Authorize]
@rendermode InteractiveServer
@using ErpFinanceiro.Application.ContasAPagar
@using ErpFinanceiro.Application.Fornecedores
@using ErpFinanceiro.Domain
@using Microsoft.AspNetCore.Authorization
@inject IGerenciadorContasPagar Gerenciador
@inject IGerenciadorFornecedores GerenciadorFornecedores

<PageTitle>Relatórios</PageTitle>
<h1>Relatórios de contas a pagar</h1>

<div class="row g-2 mb-3 align-items-end">
    <div class="col-md-3">
        <label class="form-label">Fornecedor</label>
        <select class="form-select" @bind="filtroFornecedorId">
            <option value="">Todos</option>
            @foreach (var f in fornecedores)
            {
                <option value="@f.Id">@f.RazaoSocial</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Status financeiro</label>
        <select class="form-select" @bind="filtroStatusFinanceiro">
            <option value="">Todos</option>
            @foreach (var s in Enum.GetValues<StatusFinanceiro>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Status aprovação</label>
        <select class="form-select" @bind="filtroStatusAprovacao">
            <option value="">Todos</option>
            @foreach (var s in Enum.GetValues<StatusAprovacao>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label">Vencimento de</label>
        <input class="form-control" type="date" @bind="filtroVencimentoInicial" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Vencimento até</label>
        <input class="form-control" type="date" @bind="filtroVencimentoFinal" />
    </div>
    <div class="col-md-1">
        <button class="btn btn-outline-secondary w-100" @onclick="BuscarAsync">Filtrar</button>
    </div>
</div>

@if (contas is null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <p class="mb-0"><strong>@contas.Count conta(s) encontrada(s)</strong> — Total: @contas.Sum(c => c.ValorFinal).ToString("C")</p>
        <div>
            <a class="btn btn-sm btn-outline-success" href="@LinkExportacao("xlsx")" target="_blank">Excel</a>
            <a class="btn btn-sm btn-outline-secondary" href="@LinkExportacao("csv")" target="_blank">CSV</a>
            <a class="btn btn-sm btn-outline-danger" href="@LinkExportacao("pdf")" target="_blank">PDF</a>
        </div>
    </div>
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Fornecedor</th><th>Descrição</th><th>Categoria</th><th>Centro de custo</th>
                <th>Vencimento</th><th class="text-end">Valor final</th><th>Status financeiro</th><th>Aprovação</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in contas)
            {
                <tr>
                    <td>@c.Fornecedor?.RazaoSocial</td>
                    <td>@c.Descricao</td>
                    <td>@c.Categoria?.Nome</td>
                    <td>@c.CentroCusto?.Nome</td>
                    <td>@c.Vencimento.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@c.ValorFinal.ToString("C")</td>
                    <td>@c.StatusFinanceiro</td>
                    <td>@c.StatusAprovacao</td>
                </tr>
            }
            @if (contas.Count == 0)
            {
                <tr><td colspan="8" class="text-center text-muted">Nenhuma conta encontrada para o filtro.</td></tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ContaPagar>? contas;
    private List<Fornecedor> fornecedores = new();

    private string filtroFornecedorId = "";
    private string filtroStatusFinanceiro = "";
    private string filtroStatusAprovacao = "";
    private DateOnly? filtroVencimentoInicial;
    private DateOnly? filtroVencimentoFinal;

    protected override async Task OnInitializedAsync()
    {
        fornecedores = (await GerenciadorFornecedores.ListarAsync()).ToList();
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        var filtro = new FiltroContasPagar(
            FornecedorId: Guid.TryParse(filtroFornecedorId, out var fid) ? fid : null,
            StatusFinanceiro: Enum.TryParse<StatusFinanceiro>(filtroStatusFinanceiro, out var sf) ? sf : null,
            StatusAprovacao: Enum.TryParse<StatusAprovacao>(filtroStatusAprovacao, out var sa) ? sa : null,
            VencimentoInicial: filtroVencimentoInicial,
            VencimentoFinal: filtroVencimentoFinal);
        contas = (await Gerenciador.ListarAsync(filtro)).ToList();
    }

    private string LinkExportacao(string extensao)
    {
        var parametros = new List<string>();
        if (Guid.TryParse(filtroFornecedorId, out var fid))
        {
            parametros.Add($"fornecedorId={fid}");
        }
        if (Enum.TryParse<StatusFinanceiro>(filtroStatusFinanceiro, out var sf))
        {
            parametros.Add($"statusFinanceiro={sf}");
        }
        if (Enum.TryParse<StatusAprovacao>(filtroStatusAprovacao, out var sa))
        {
            parametros.Add($"statusAprovacao={sa}");
        }
        if (filtroVencimentoInicial is DateOnly ini)
        {
            parametros.Add($"vencimentoInicial={ini:yyyy-MM-dd}");
        }
        if (filtroVencimentoFinal is DateOnly fim)
        {
            parametros.Add($"vencimentoFinal={fim:yyyy-MM-dd}");
        }

        var query = parametros.Count == 0 ? "" : "?" + string.Join("&", parametros);
        return $"/relatorios/contas-a-pagar.{extensao}{query}";
    }
}
