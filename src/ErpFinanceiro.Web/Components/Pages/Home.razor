@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using ErpFinanceiro.Application.Dashboard
@using ErpFinanceiro.Application.DocumentosIa
@using ErpFinanceiro.Domain
@using Microsoft.AspNetCore.Authorization
@inject IPainelFinanceiro Painel
@inject IGerenciadorDocumentosImportados Documentos
@inject NavigationManager NavigationManager

<PageTitle>Painel financeiro</PageTitle>
<h1>Painel financeiro</h1>

@if (indicadores is null)
{
    <p><em>Carregando...</em></p>
}
else
{
    @if (indicadores.QuantidadeVencidas > 0 || indicadores.TotalAPagarHoje > 0 || documentosPendentes > 0)
    {
        <h2 class="h5 mt-4 mb-2">Precisa da sua atenção</h2>
        <div class="atencao-grade mb-4">
            @if (indicadores.QuantidadeVencidas > 0)
            {
                <div class="atencao-cartao atencao-perigo">
                    <div class="atencao-rotulo">Vencidas</div>
                    <div class="atencao-valor num">@indicadores.TotalVencidas.ToString("C")</div>
                    <div class="atencao-meta">@indicadores.QuantidadeVencidas conta(s) passaram do vencimento</div>
                    <button class="atencao-acao" @onclick='() => IrPara("/contas-a-pagar")'>Ver contas vencidas →</button>
                </div>
            }
            @if (indicadores.TotalAPagarHoje > 0)
            {
                <div class="atencao-cartao atencao-alerta">
                    <div class="atencao-rotulo">Vence hoje</div>
                    <div class="atencao-valor num">@indicadores.TotalAPagarHoje.ToString("C")</div>
                    <div class="atencao-meta">Contas para pagar hoje</div>
                    <button class="atencao-acao" @onclick='() => IrPara("/contas-a-pagar")'>Ver e dar baixa →</button>
                </div>
            }
            @if (documentosPendentes > 0)
            {
                <div class="atencao-cartao atencao-info">
                    <div class="atencao-rotulo">Documentos pendentes</div>
                    <div class="atencao-valor num">@documentosPendentes</div>
                    <div class="atencao-meta">Lançamentos da IA aguardando revisão</div>
                    <button class="atencao-acao" @onclick='() => IrPara("/central-de-documentos")'>Revisar agora →</button>
                </div>
            }
        </div>
    }

    <div class="kpi-grade mb-3">
        <div class="kpi-cartao">
            <div class="kpi-rotulo">Total em aberto</div>
            <div class="kpi-valor num">@indicadores.TotalEmAberto.ToString("C")</div>
            <div class="kpi-nota">@indicadores.QuantidadeEmAberto conta(s) em aberto no total</div>
        </div>
        <div class="kpi-cartao">
            <div class="kpi-rotulo">Pago no mês</div>
            <div class="kpi-valor num" style="color:var(--cor-sucesso)">@indicadores.TotalPagoNoMes.ToString("C")</div>
            <div class="kpi-nota">Baixas já confirmadas neste mês</div>
        </div>
        <div class="kpi-cartao">
            <div class="kpi-rotulo">Próximos 7 dias</div>
            <div class="kpi-valor num">@indicadores.TotalAPagarProximos7Dias.ToString("C")</div>
            <div class="kpi-nota">A vencer na próxima semana</div>
        </div>
    </div>

    <div class="metricas-linha mb-4">
        <div class="metrica-chip">
            <div class="metrica-rotulo">A pagar no mês</div>
            <div class="metrica-valor num">@indicadores.TotalAPagarNoMes.ToString("C")</div>
        </div>
        <div class="metrica-chip">
            <div class="metrica-rotulo">Pago no ano</div>
            <div class="metrica-valor num">@indicadores.TotalPagoNoAno.ToString("C")</div>
        </div>
        <div class="metrica-chip">
            <div class="metrica-rotulo">Gasto no cartão (ano)</div>
            <div class="metrica-valor num">@indicadores.TotalDespesasCartaoNoAno.ToString("C")</div>
        </div>
        @if (indicadores.QuantidadePagamentoNaoIdentificado > 0)
        {
            <div class="metrica-chip">
                <div class="metrica-rotulo">Pagamento não identificado</div>
                <div class="metrica-valor num" style="color:var(--cor-alerta)">@indicadores.TotalPagamentoNaoIdentificado.ToString("C")</div>
            </div>
        }
    </div>

    <h3 class="h5 mb-2">Próximos vencimentos</h3>
    <div class="tabela-cartao">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Fornecedor</th><th>Descrição</th><th>Vencimento</th><th class="text-end">Valor</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var v in indicadores.ProximosVencimentos)
            {
                <tr>
                    <td>@v.Fornecedor</td>
                    <td>@v.Descricao</td>
                    <td class="num">@v.Vencimento.ToString("dd/MM/yyyy")</td>
                    <td class="text-end num">@v.ValorFinal.ToString("C")</td>
                    <td>@StatusPill(v.Vencimento)</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => AbrirConta(v.ContaPagarId)">Abrir</button>
                    </td>
                </tr>
            }
            @if (indicadores.ProximosVencimentos.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted">Nenhuma conta em aberto.</td></tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private IndicadoresPainel? indicadores;
    private int documentosPendentes;

    protected override async Task OnInitializedAsync()
    {
        indicadores = await Painel.ObterAsync();
        var pendentes = await Documentos.ListarAsync(new FiltroDocumentosImportados(StatusImportacaoDocumento.AguardandoRevisao));
        documentosPendentes = pendentes.Count;
    }

    private void AbrirConta(Guid id) => NavigationManager.NavigateTo($"/contas-a-pagar/{id}");

    private void IrPara(string rota) => NavigationManager.NavigateTo(rota);

    private RenderFragment StatusPill(DateOnly vencimento)
    {
        var hoje = DateOnly.FromDateTime(DateTime.Today);
        var (classe, texto) = vencimento < hoje
            ? ("pill pill-perigo", "Vencida")
            : vencimento == hoje
                ? ("pill pill-alerta", "Vence hoje")
                : ("pill pill-neutra", "Em aberto");

        return builder =>
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", classe);
            builder.AddContent(2, texto);
            builder.CloseElement();
        };
    }
}
