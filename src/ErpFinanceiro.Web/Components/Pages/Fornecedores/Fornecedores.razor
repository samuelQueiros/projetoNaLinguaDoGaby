@page "/fornecedores"
@attribute [Authorize]
@rendermode InteractiveServer
@using ErpFinanceiro.Application.Fornecedores
@using Microsoft.AspNetCore.Authorization
@inject IGerenciadorFornecedores Gerenciador
@inject NavigationManager NavigationManager

<PageTitle>Fornecedores</PageTitle>

<h1>Fornecedores</h1>

@if (fornecedores is not null)
{
    <div class="resumo-linha mb-3">
        <div class="resumo-chip">Total <span class="valor">@fornecedores.Count</span></div>
        <div class="resumo-chip">Exibindo <span class="valor">@Filtrados.Count()</span></div>
    </div>
}

<div class="barra-filtros mb-3">
    <input class="form-control" @bind="filtro" @bind:event="oninput" placeholder="Buscar por razão social, nome fantasia ou CNPJ/CPF..." style="min-width: 20rem;" />
    <select class="form-select" @bind="formaPagamentoFiltro">
        <option value="">Qualquer forma de pagamento</option>
        @foreach (var forma in FormasDePagamentoDisponiveis)
        {
            <option value="@forma">@forma</option>
        }
    </select>
    @if (!string.IsNullOrWhiteSpace(filtro) || !string.IsNullOrWhiteSpace(formaPagamentoFiltro))
    {
        <button class="limpar-filtros" @onclick="LimparFiltros">Limpar filtros</button>
    }
    <button class="btn btn-primary ms-auto" @onclick="NovoFornecedor">+ Novo fornecedor</button>
</div>

@if (fornecedores is null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <div class="tabela-cartao">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Fornecedor</th>
                <th>CNPJ/CPF</th>
                <th>Forma de pagamento padrão</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var f in Filtrados)
            {
                <tr style="cursor: pointer;" @onclick="() => AbrirFornecedor(f.Id)">
                    <td>
                        <div class="entidade-celula">
                            <div class="entidade-avatar">@Iniciais(f.RazaoSocial)</div>
                            <div>
                                <div class="entidade-nome">@f.RazaoSocial</div>
                                @if (!string.IsNullOrWhiteSpace(f.NomeFantasia))
                                {
                                    <div class="entidade-detalhe">@f.NomeFantasia</div>
                                }
                            </div>
                        </div>
                    </td>
                    <td class="num">@FormatarDocumento(f.CnpjCpf)</td>
                    <td>@(f.FormaPagamentoPadrao?.Nome ?? "—")</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => AbrirFornecedor(f.Id)" @onclick:stopPropagation="true">Abrir</button>
                    </td>
                </tr>
            }
            @if (!Filtrados.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Nenhum fornecedor encontrado com esses filtros.</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private List<ErpFinanceiro.Domain.Fornecedor>? fornecedores;
    private string filtro = "";
    private string formaPagamentoFiltro = "";

    private IEnumerable<ErpFinanceiro.Domain.Fornecedor> Filtrados =>
        (fornecedores ?? Enumerable.Empty<ErpFinanceiro.Domain.Fornecedor>())
        .Where(f => string.IsNullOrWhiteSpace(filtro) ||
                    f.RazaoSocial.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                    (f.NomeFantasia?.Contains(filtro, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (SomenteDigitos(filtro).Length > 0 && f.CnpjCpf.Contains(SomenteDigitos(filtro))))
        .Where(f => string.IsNullOrWhiteSpace(formaPagamentoFiltro) ||
                    f.FormaPagamentoPadrao?.Nome == formaPagamentoFiltro);

    private IEnumerable<string> FormasDePagamentoDisponiveis =>
        (fornecedores ?? Enumerable.Empty<ErpFinanceiro.Domain.Fornecedor>())
        .Select(f => f.FormaPagamentoPadrao?.Nome)
        .Where(nome => !string.IsNullOrWhiteSpace(nome))
        .Distinct()
        .OrderBy(nome => nome)!;

    protected override async Task OnInitializedAsync()
    {
        fornecedores = (await Gerenciador.ListarAsync()).ToList();
    }

    private void NovoFornecedor() => NavigationManager.NavigateTo("/fornecedores/novo");

    private void AbrirFornecedor(Guid id) => NavigationManager.NavigateTo($"/fornecedores/{id}");

    private void LimparFiltros()
    {
        filtro = "";
        formaPagamentoFiltro = "";
    }

    private static string Iniciais(string razaoSocial)
    {
        var palavras = razaoSocial.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var letras = palavras.Take(2).Select(p => char.ToUpperInvariant(p[0]));
        var resultado = new string(letras.ToArray());
        return resultado.Length > 0 ? resultado : "?";
    }

    private static string SomenteDigitos(string valor) => new(valor.Where(char.IsDigit).ToArray());

    private static string FormatarDocumento(string digitos) => digitos.Length switch
    {
        14 => $"{digitos[..2]}.{digitos[2..5]}.{digitos[5..8]}/{digitos[8..12]}-{digitos[12..]}",
        11 => $"{digitos[..3]}.{digitos[3..6]}.{digitos[6..9]}-{digitos[9..]}",
        _ => digitos,
    };
}
