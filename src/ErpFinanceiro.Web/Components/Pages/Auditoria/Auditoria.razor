@page "/auditoria"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@using ErpFinanceiro.Application.Auditoria
@using Microsoft.AspNetCore.Authorization
@inject IConsultaAuditoria Consulta

<PageTitle>Log de auditoria</PageTitle>
<h1>Log de auditoria</h1>

<div class="row g-2 mb-3 align-items-end">
    <div class="col-md-3">
        <label class="form-label">Tipo de entidade</label>
        <select class="form-select" @bind="filtroTipo">
            <option value="">Todos</option>
            @foreach (var t in tipos)
            {
                <option value="@t">@t</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Data inicial</label>
        <input class="form-control" type="date" @bind="filtroDataInicial" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Data final</label>
        <input class="form-control" type="date" @bind="filtroDataFinal" />
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-secondary w-100" @onclick="BuscarAsync">Filtrar</button>
    </div>
</div>

@if (registros is null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <p class="text-muted">@registros.Count registro(s) — mostrando os mais recentes primeiro (limite de 200).</p>
    <div class="tabela-cartao">
    <table class="table table-striped align-middle table-sm">
        <thead>
            <tr><th>Data/hora</th><th>Usuário</th><th>Ação</th><th>Entidade</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var r in registros)
            {
                <tr>
                    <td>@r.Data.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@r.UsuarioNome</td>
                    <td>@r.Acao</td>
                    <td>@r.TipoEntidade <small class="text-muted">#@r.EntidadeId.ToString()[..8]</small></td>
                    <td>
                        <button class="btn btn-sm btn-link" @onclick="() => AlternarDetalhe(r)">
                            @(detalheAberto == r ? "Ocultar" : "Detalhes")
                        </button>
                    </td>
                </tr>
                @if (detalheAberto == r)
                {
                    <tr>
                        <td colspan="5">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>Valor anterior</strong>
                                    <pre class="small bg-light p-2">@(r.ValorAnteriorJson ?? "—")</pre>
                                </div>
                                <div class="col-md-6">
                                    <strong>Valor novo</strong>
                                    <pre class="small bg-light p-2">@(r.ValorNovoJson ?? "—")</pre>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            }
            @if (registros.Count == 0)
            {
                <tr><td colspan="5" class="text-center text-muted">Nenhum registro encontrado.</td></tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private List<RegistroAuditoria>? registros;
    private List<string> tipos = new();
    private RegistroAuditoria? detalheAberto;

    private string filtroTipo = "";
    private DateTime? filtroDataInicial;
    private DateTime? filtroDataFinal;

    protected override async Task OnInitializedAsync()
    {
        tipos = (await Consulta.ListarTiposEntidadeAsync()).ToList();
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        var filtro = new FiltroLogAuditoria(
            TipoEntidade: string.IsNullOrWhiteSpace(filtroTipo) ? null : filtroTipo,
            DataInicial: filtroDataInicial,
            DataFinal: filtroDataFinal?.AddDays(1).AddTicks(-1));
        registros = (await Consulta.ListarAsync(filtro)).ToList();
        detalheAberto = null;
    }

    private void AlternarDetalhe(RegistroAuditoria r) => detalheAberto = detalheAberto == r ? null : r;
}
