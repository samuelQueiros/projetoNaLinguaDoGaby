@page "/cartoes"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using ErpFinanceiro.Application
@using ErpFinanceiro.Application.Cartoes
@using ErpFinanceiro.Domain
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject IGerenciadorCartoes Gerenciador
@inject UserManager<Usuario> UserManager

<PageTitle>Cartões</PageTitle>

<h1>Cartões</h1>

@if (cartoes is not null)
{
    <div class="resumo-linha mb-3">
        <div class="resumo-chip">Total <span class="valor">@cartoes.Count</span></div>
        <div class="resumo-chip">Ativos <span class="valor">@cartoes.Count(c => c.Status == StatusCartao.Ativo)</span></div>
        @if (cartoes.Any(c => c.Status == StatusCartao.Bloqueado))
        {
            <div class="resumo-chip resumo-alerta">Bloqueados <span class="valor">@cartoes.Count(c => c.Status == StatusCartao.Bloqueado)</span></div>
        }
        <div class="resumo-chip">Limite total <span class="valor num">@cartoes.Sum(c => c.Limite).ToString("C")</span></div>
    </div>
}

<div class="barra-filtros mb-3">
    <input class="form-control" @bind="filtroTexto" @bind:event="oninput" placeholder="Buscar por apelido ou instituição..." style="min-width: 18rem;" />
    <select class="form-select" @bind="filtroInstituicao">
        <option value="">Qualquer instituição</option>
        @foreach (var inst in InstituicoesDisponiveis)
        {
            <option value="@inst">@inst</option>
        }
    </select>
    <select class="form-select" @bind="filtroStatus">
        <option value="">Qualquer status</option>
        <option value="@StatusCartao.Ativo">Ativo</option>
        <option value="@StatusCartao.Bloqueado">Bloqueado</option>
        <option value="@StatusCartao.Cancelado">Cancelado</option>
    </select>
    <select class="form-select" @bind="filtroResponsavelId">
        <option value="">Qualquer responsável</option>
        @foreach (var u in usuarios)
        {
            <option value="@u.Id">@u.Nome</option>
        }
    </select>
    @if (HaFiltrosAtivos)
    {
        <button class="limpar-filtros" @onclick="LimparFiltros">Limpar filtros</button>
    }
    <AuthorizeView Roles="Financeiro,Administrador">
        <Authorized>
            <button class="btn btn-primary ms-auto" @onclick="AbrirNovo">+ Novo cartão</button>
        </Authorized>
    </AuthorizeView>
</div>

@if (cartoes is null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <div class="tabela-cartao">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Apelido</th>
                <th>Instituição</th>
                <th>Bandeira</th>
                <th>Final</th>
                <th>Limite</th>
                <th>Fechamento</th>
                <th>Vencimento</th>
                <th>Responsável</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Filtrados)
            {
                <tr>
                    <td>@c.Apelido</td>
                    <td>@c.InstituicaoFinanceira</td>
                    <td>@c.Bandeira</td>
                    <td class="num">**** @c.UltimosQuatroDigitos</td>
                    <td class="num">@c.Limite.ToString("C")</td>
                    <td class="num">Dia @c.DiaFechamento</td>
                    <td class="num">Dia @c.DiaVencimento</td>
                    <td>@c.Responsavel?.Nome</td>
                    <td><span class="pill @c.Status.Pill()">@c.Status.Rotulo()</span></td>
                    <td class="text-end">
                        <AuthorizeView Roles="Financeiro,Administrador">
                            <Authorized>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => AbrirEdicao(c)">Editar</button>
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>
            }
            @if (!Filtrados.Any())
            {
                <tr><td colspan="10" class="text-center text-muted">Nenhum cartão encontrado com esses filtros.</td></tr>
            }
        </tbody>
    </table>
    </div>
}

@if (formularioAberto)
{
    <div class="card" style="max-width: 36rem;">
        <div class="card-body">
            <h5 class="card-title">@(editandoId is null ? "Novo cartão" : "Editar cartão")</h5>
            <EditForm Model="modelo" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="form-label">Apelido</label>
                        <InputText class="form-control" @bind-Value="modelo.Apelido" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Instituição financeira</label>
                        <InputText class="form-control" @bind-Value="modelo.InstituicaoFinanceira" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <label class="form-label">Bandeira</label>
                        <InputText class="form-control" @bind-Value="modelo.Bandeira" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Últimos 4 dígitos</label>
                        <InputText class="form-control" @bind-Value="modelo.UltimosQuatroDigitos" maxlength="4" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Limite</label>
                        <InputNumber class="form-control" @bind-Value="modelo.Limite" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <label class="form-label">Dia de fechamento</label>
                        <InputNumber class="form-control" @bind-Value="modelo.DiaFechamento" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Dia de vencimento</label>
                        <InputNumber class="form-control" @bind-Value="modelo.DiaVencimento" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Responsável</label>
                        <InputSelect class="form-select" @bind-Value="modelo.ResponsavelId">
                            <option value="">—</option>
                            @foreach (var u in usuarios)
                            {
                                <option value="@u.Id">@u.Nome</option>
                            }
                        </InputSelect>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(erro))
                {
                    <div class="alert alert-danger">@erro</div>
                }
                <button type="submit" class="btn btn-primary">Salvar</button>
                <button type="button" class="btn btn-link" @onclick="() => formularioAberto = false">Cancelar</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Cartao>? cartoes;
    private List<Usuario> usuarios = new();
    private bool formularioAberto;
    private Guid? editandoId;
    private FormularioModelo modelo = new();
    private string? erro;
    private Guid usuarioId;

    [CascadingParameter]
    private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthState { get; set; }

    private string filtroTexto = "";
    private string filtroInstituicao = "";
    private string filtroStatus = "";
    private string filtroResponsavelId = "";

    private bool HaFiltrosAtivos =>
        !string.IsNullOrWhiteSpace(filtroTexto) || !string.IsNullOrWhiteSpace(filtroInstituicao) ||
        !string.IsNullOrWhiteSpace(filtroStatus) || !string.IsNullOrWhiteSpace(filtroResponsavelId);

    private IEnumerable<string> InstituicoesDisponiveis =>
        (cartoes ?? new List<Cartao>()).Select(c => c.InstituicaoFinanceira).Distinct().OrderBy(i => i);

    private IEnumerable<Cartao> Filtrados =>
        (cartoes ?? new List<Cartao>())
        .Where(c => string.IsNullOrWhiteSpace(filtroTexto) ||
                    c.Apelido.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase) ||
                    c.InstituicaoFinanceira.Contains(filtroTexto, StringComparison.OrdinalIgnoreCase))
        .Where(c => string.IsNullOrWhiteSpace(filtroInstituicao) || c.InstituicaoFinanceira == filtroInstituicao)
        .Where(c => string.IsNullOrWhiteSpace(filtroStatus) || c.Status.ToString() == filtroStatus)
        .Where(c => string.IsNullOrWhiteSpace(filtroResponsavelId) || c.ResponsavelId.ToString() == filtroResponsavelId);

    private void LimparFiltros()
    {
        filtroTexto = "";
        filtroInstituicao = "";
        filtroStatus = "";
        filtroResponsavelId = "";
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await (AuthState ?? Task.FromResult(new Microsoft.AspNetCore.Components.Authorization.AuthenticationState(new ClaimsPrincipal())));
        var usuarioLogado = await UserManager.GetUserAsync(authState.User);
        usuarioId = usuarioLogado?.Id ?? Guid.Empty;

        usuarios = UserManager.Users.Where(u => u.Ativo).OrderBy(u => u.Nome).ToList();
        await CarregarAsync();
    }

    private async Task CarregarAsync() => cartoes = (await Gerenciador.ListarAsync()).ToList();

    private void AbrirNovo()
    {
        editandoId = null;
        modelo = new FormularioModelo();
        erro = null;
        formularioAberto = true;
    }

    private void AbrirEdicao(Cartao c)
    {
        editandoId = c.Id;
        modelo = new FormularioModelo
        {
            Apelido = c.Apelido,
            InstituicaoFinanceira = c.InstituicaoFinanceira,
            Bandeira = c.Bandeira,
            UltimosQuatroDigitos = c.UltimosQuatroDigitos,
            Limite = c.Limite,
            DiaFechamento = c.DiaFechamento,
            DiaVencimento = c.DiaVencimento,
            ResponsavelId = c.ResponsavelId.ToString(),
        };
        erro = null;
        formularioAberto = true;
    }

    private async Task SalvarAsync()
    {
        erro = null;
        if (string.IsNullOrWhiteSpace(modelo.ResponsavelId))
        {
            erro = "Selecione um responsável.";
            return;
        }

        var input = new CartaoInput(
            modelo.InstituicaoFinanceira, modelo.Bandeira, modelo.Apelido, modelo.UltimosQuatroDigitos,
            modelo.Limite, modelo.DiaFechamento, modelo.DiaVencimento, Guid.Parse(modelo.ResponsavelId));

        var resultado = editandoId is Guid id
            ? await Gerenciador.EditarAsync(id, input, usuarioId)
            : await ResultadoDeCriarAsync(input);

        if (!resultado.Sucesso)
        {
            erro = string.Join("; ", resultado.Erros);
            return;
        }

        formularioAberto = false;
        await CarregarAsync();
    }

    private async Task<ResultadoOperacao> ResultadoDeCriarAsync(CartaoInput input)
    {
        try
        {
            await Gerenciador.CriarAsync(input, usuarioId);
            return ResultadoOperacao.Ok();
        }
        catch (InvalidOperationException ex)
        {
            return ResultadoOperacao.Falha(ex.Message);
        }
    }

    private sealed class FormularioModelo
    {
        [Required] public string Apelido { get; set; } = "";
        [Required] public string InstituicaoFinanceira { get; set; } = "";
        [Required] public string Bandeira { get; set; } = "";
        [Required, MaxLength(4), MinLength(4)] public string UltimosQuatroDigitos { get; set; } = "";
        [Range(0, double.MaxValue)] public decimal Limite { get; set; }
        [Range(1, 31)] public int DiaFechamento { get; set; } = 1;
        [Range(1, 31)] public int DiaVencimento { get; set; } = 10;
        public string ResponsavelId { get; set; } = "";
    }
}
