@page "/configuracoes-ia"
@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer
@using ErpFinanceiro.Application.ConfiguracoesIa
@using ErpFinanceiro.Domain
@using Microsoft.AspNetCore.Authorization
@inject IGerenciadorConfiguracaoIa Gerenciador

<PageTitle>Configurações de IA</PageTitle>

<h1>Configurações de IA</h1>
<p class="text-muted">
    Provedor, modelo e chave usados pela leitura automática de documentos e pelo chat vêm das variáveis de
    ambiente do servidor (<code>Ia__Documentos__*</code> e <code>Ia__Chat__*</code>) — não são editáveis por
    aqui. Pra trocar, atualize a variável de ambiente e reinicie o container; esta tela só mostra o que está
    configurado agora e testa a conexão.
</p>

@if (carregando)
{
    <p><em>Carregando...</em></p>
}
else
{
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Leitura de documentos</h5>
                    <p class="card-subtitle mb-3 text-muted">
                        Usado pela Central de Documentos para classificar e extrair dados dos arquivos enviados.
                    </p>
                    @CartaoConteudo(documentos, "Ia__Documentos")
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Chat</h5>
                    <p class="card-subtitle mb-3 text-muted">
                        Usado pelo assistente de IA no canto da tela para responder perguntas sobre os dados do sistema.
                    </p>
                    @CartaoConteudo(chat, "Ia__Chat")
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool carregando = true;
    private readonly SecaoFinalidade documentos = new(FinalidadeConfiguracaoIa.Documentos);
    private readonly SecaoFinalidade chat = new(FinalidadeConfiguracaoIa.Chat);

    protected override async Task OnInitializedAsync()
    {
        documentos.Configuracao = await Gerenciador.ObterAsync(documentos.Finalidade);
        chat.Configuracao = await Gerenciador.ObterAsync(chat.Finalidade);
        carregando = false;
    }

    private async Task TestarAsync(SecaoFinalidade secao)
    {
        secao.Testando = true;
        secao.Mensagem = null;
        secao.MensagemEhErro = false;
        StateHasChanged();

        var resultado = await Gerenciador.TestarConexaoAsync(secao.Finalidade);
        secao.Testando = false;
        secao.Mensagem = resultado.Sucesso ? "Conexão funcionando." : string.Join("; ", resultado.Erros);
        secao.MensagemEhErro = !resultado.Sucesso;
    }

    private RenderFragment CartaoConteudo(SecaoFinalidade secao, string prefixoEnv) => @<text>
        @{ var config = secao.Configuracao; }
        <dl class="row mb-0">
            <dt class="col-5">Status</dt>
            <dd class="col-7">
                @if (config is { Ativo: true })
                {
                    <span class="text-success">Ativo</span>
                }
                else if (config is null)
                {
                    <span class="text-danger">Não configurado — faltam variáveis de ambiente</span>
                }
                else
                {
                    <span class="text-danger">Inativo (@(prefixoEnv)__Ativo=false)</span>
                }
            </dd>

            <dt class="col-5">Provedor</dt>
            <dd class="col-7">@(config?.Provedor.ToString() ?? "—")</dd>

            <dt class="col-5">Modelo</dt>
            <dd class="col-7">@(config?.Modelo ?? "—")</dd>

            <dt class="col-5">Chave de API</dt>
            <dd class="col-7">@(string.IsNullOrWhiteSpace(config?.ApiKey) ? "não cadastrada" : "•••• configurada")</dd>

            <dt class="col-5">Timeout</dt>
            <dd class="col-7">@(config is null ? "—" : $"{config.TimeoutSegundos}s")</dd>
        </dl>

        <p class="text-muted small mt-2 mb-3">
            Variáveis: @(prefixoEnv)__Provedor, @(prefixoEnv)__Modelo, @(prefixoEnv)__ApiKey,
            @(prefixoEnv)__TimeoutSegundos (opcional), @(prefixoEnv)__Ativo (opcional).
        </p>

        @if (!string.IsNullOrEmpty(secao.Mensagem))
        {
            <div class="alert @(secao.MensagemEhErro ? "alert-danger" : "alert-success") py-2">@secao.Mensagem</div>
        }

        <button type="button" class="btn btn-outline-secondary" disabled="@secao.Testando" @onclick="() => TestarAsync(secao)">
            @(secao.Testando ? "Testando..." : "Testar conexão")
        </button>
    </text>;

    private sealed class SecaoFinalidade(FinalidadeConfiguracaoIa finalidade)
    {
        public FinalidadeConfiguracaoIa Finalidade { get; } = finalidade;
        public ConfiguracaoIa? Configuracao { get; set; }
        public bool Testando { get; set; }
        public string? Mensagem { get; set; }
        public bool MensagemEhErro { get; set; }
    }
}
