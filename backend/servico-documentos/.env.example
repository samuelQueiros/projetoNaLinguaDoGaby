# Copie para .env e ajuste. NUNCA versione o .env com a chave real.

# ----- LLM -----
# none      -> só extração por regex/heurística (offline, sem custo)
# anthropic -> usa a API da Anthropic (Claude)
# openai    -> usa a API da OpenAI
# gemini    -> usa a API do Google Gemini
#
# Esses valores são o fallback quando o .NET não manda override por
# requisição (ver app/main.py). O jeito normal de configurar isso agora é
# pela tela /configuracoes-ia do ERP (Administrador) — sem precisar editar
# este .env nem reiniciar o serviço.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SEGUNDOS=90
# nº de tentativas antes de desistir e cair pro fallback regex-only
# (rate limit/erro 5xx passageiro do provider é o caso mais comum):
LLM_MAX_TENTATIVAS=2

# ----- Limites de upload -----
MAX_ARQUIVO_MB=25
# nº máx. de linhas de planilha lidas por upload de XLSX (proteção contra
# arquivo pequeno em disco mas desproporcional depois de descompactado):
XLSX_MAX_LINHAS=50000

# ----- OCR -----
OCR_HABILITADO=true
OCR_IDIOMA=por+eng
# se o texto nativo tiver menos que isto de caracteres, tenta OCR:
OCR_LIMIAR_CARACTERES=40
# nº máx. de páginas rasterizadas por PDF escaneado (mesma lógica do limite
# de linhas do XLSX — MAX_ARQUIVO_MB não limita nº de páginas):
OCR_MAX_PAGINAS=30

# ----- Autenticação entre serviços -----
# Segredo compartilhado exigido no header X-Internal-Token em POST /extrair.
# Vazio (padrão) = checagem desativada — defina em produção; combina com
# isolamento de rede (docker network privada), não substitui. O valor aqui
# precisa ser o mesmo configurado no backend .NET (appsettings: Ia:Leitor:TokenInterno).
INTERNAL_TOKEN=

# ----- Log -----
LOG_LEVEL=INFO
# true -> loga trechos de texto extraído (NÃO usar em produção: CPF/CNPJ são dados sensíveis)
LOG_TEXTO_BRUTO=false
