@page "/boletos"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using ErpFinanceiro.Application.Boletos
@using ErpFinanceiro.Application.ContasAPagar
@using ErpFinanceiro.Application.Fornecedores
@using ErpFinanceiro.Domain
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@inject IGerenciadorBoletos Gerenciador
@inject IGerenciadorFornecedores GerenciadorFornecedores
@inject IGerenciadorContasPagar GerenciadorContasPagar
@inject UserManager<Usuario> UserManager

<PageTitle>Boletos</PageTitle>
<h1>Boletos</h1>

<div class="mb-3 d-flex gap-2 align-items-end flex-wrap">
    <div>
        <label class="form-label">Fornecedor</label>
        <select class="form-select" @bind="filtroFornecedorId">
            <option value="">(todos)</option>
            @foreach (var f in fornecedores)
            {
                <option value="@f.Id">@f.RazaoSocial</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label">Status</label>
        <select class="form-select" @bind="filtroStatus">
            <option value="">(todos)</option>
            @foreach (var s in Enum.GetValues<StatusBoleto>())
            {
                <option value="@s">@RotuloStatus(s)</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label">Ano</label>
        <input class="form-control" type="number" style="width: 7rem;" @bind="filtroAno" />
    </div>
    <button class="btn btn-outline-secondary" @onclick="BuscarAsync">Buscar</button>
    <button class="btn btn-primary ms-auto" @onclick="() => AbrirFormularioAsync(null)">+ Novo boleto</button>
</div>

@if (boletos is null)
{
    <p><em>Carregando...</em></p>
}
else
{
    <p class="text-muted">@boletos.Count boleto(s) — total R$ @boletos.Sum(b => b.Valor).ToString("N2")</p>
    <div class="tabela-cartao">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Número</th><th>Fornecedor</th><th>Vencimento</th><th class="text-end">Valor</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var b in boletos)
            {
                <tr>
                    <td>@b.Numero</td>
                    <td>@b.Fornecedor?.RazaoSocial</td>
                    <td>@b.Vencimento.ToString("dd/MM/yyyy")</td>
                    <td class="text-end">@b.Valor.ToString("C")</td>
                    <td><span class="badge @ClasseStatus(b.Status)">@RotuloStatus(b.Status)</span></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => AbrirFormularioAsync(b)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ExcluirAsync(b.Id)">Excluir</button>
                    </td>
                </tr>
            }
            @if (boletos.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted">Nenhum boleto encontrado.</td></tr>
            }
        </tbody>
    </table>
    </div>
}

@if (formularioAberto)
{
    <div class="modal d-block" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <EditForm Model="modelo" OnValidSubmit="SalvarAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header"><h5 class="modal-title">@(editandoId is null ? "Novo boleto" : "Editar boleto")</h5></div>
                    <div class="modal-body">
                        @if (erro is not null)
                        {
                            <div class="alert alert-danger">@erro</div>
                        }
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label">Fornecedor</label>
                                <InputSelect class="form-select" @bind-Value="modelo.FornecedorId" @bind-Value:after="AoTrocarFornecedorAsync">
                                    <option value="@Guid.Empty">Selecione...</option>
                                    @foreach (var f in fornecedores)
                                    {
                                        <option value="@f.Id">@f.RazaoSocial</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Conta a pagar</label>
                                <InputSelect class="form-select" @bind-Value="modelo.ContaPagarId">
                                    <option value="@Guid.Empty">Selecione...</option>
                                    @foreach (var c in contasDoFornecedor)
                                    {
                                        <option value="@c.Id">@c.Descricao — @c.Vencimento.ToString("dd/MM/yyyy")</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Número</label>
                                <InputText class="form-control" @bind-Value="modelo.Numero" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Linha digitável</label>
                                <InputText class="form-control" @bind-Value="modelo.LinhaDigitavel" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Código de barras</label>
                                <InputText class="form-control" @bind-Value="modelo.CodigoBarras" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Valor</label>
                                <InputNumber class="form-control" @bind-Value="modelo.Valor" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Vencimento</label>
                                <InputDate class="form-control" @bind-Value="modelo.Vencimento" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Data de pagamento</label>
                                <InputDate class="form-control" @bind-Value="modelo.DataPagamento" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Banco</label>
                                <InputText class="form-control" @bind-Value="modelo.Banco" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Status</label>
                                <InputSelect class="form-select" @bind-Value="modelo.Status">
                                    @foreach (var s in Enum.GetValues<StatusBoleto>())
                                    {
                                        <option value="@s">@RotuloStatus(s)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Observações</label>
                                <InputTextArea class="form-control" @bind-Value="modelo.Observacoes" />
                            </div>
                        </div>
                        @if (editandoId is Guid boletoId)
                        {
                            @if (recemCriado)
                            {
                                <div class="alert alert-success mt-3">Boleto salvo! Anexe o PDF abaixo — ou feche esta janela e anexe depois.</div>
                            }
                            <PainelAnexos EntidadeTipo="EntidadeAnexo.Boleto" EntidadeId="boletoId" />
                        }
                        else
                        {
                            <p class="text-muted mt-3"><small>Você poderá anexar o PDF assim que salvar os dados abaixo.</small></p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="() => formularioAberto = false">@(recemCriado ? "Concluir" : "Cancelar")</button>
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Boleto>? boletos;
    private List<Fornecedor> fornecedores = new();
    private List<ContaPagar> contasDoFornecedor = new();

    private string filtroFornecedorId = "";
    private string filtroStatus = "";
    private int? filtroAno;

    private bool formularioAberto;
    private Guid? editandoId;
    private bool recemCriado;
    private Modelo modelo = new();
    private string? erro;
    private Guid usuarioId;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await (AuthState ?? Task.FromResult(new AuthenticationState(new ClaimsPrincipal())));
        usuarioId = (await UserManager.GetUserAsync(authState.User))?.Id ?? Guid.Empty;

        fornecedores = (await GerenciadorFornecedores.ListarAsync()).ToList();
        await BuscarAsync();
    }

    private async Task BuscarAsync()
    {
        var filtro = new FiltroBoletos(
            FornecedorId: Guid.TryParse(filtroFornecedorId, out var fid) ? fid : null,
            Status: Enum.TryParse<StatusBoleto>(filtroStatus, out var st) ? st : null,
            Ano: filtroAno);
        boletos = (await Gerenciador.ListarAsync(filtro)).ToList();
    }

    private async Task AbrirFormularioAsync(Boleto? b)
    {
        erro = null;
        recemCriado = false;
        editandoId = b?.Id;
        modelo = b is null
            ? new Modelo { Vencimento = DateTime.Today }
            : new Modelo
            {
                FornecedorId = b.FornecedorId,
                ContaPagarId = b.ContaPagarId,
                Numero = b.Numero,
                LinhaDigitavel = b.LinhaDigitavel,
                CodigoBarras = b.CodigoBarras,
                Valor = b.Valor,
                Vencimento = b.Vencimento.ToDateTime(TimeOnly.MinValue),
                DataPagamento = b.DataPagamento?.ToDateTime(TimeOnly.MinValue),
                Banco = b.Banco,
                Status = b.Status,
                Observacoes = b.Observacoes,
            };

        contasDoFornecedor = modelo.FornecedorId == Guid.Empty
            ? new List<ContaPagar>()
            : (await GerenciadorContasPagar.ListarAsync(new FiltroContasPagar(FornecedorId: modelo.FornecedorId))).ToList();

        formularioAberto = true;
    }

    private async Task AoTrocarFornecedorAsync()
    {
        modelo.ContaPagarId = Guid.Empty;
        contasDoFornecedor = modelo.FornecedorId == Guid.Empty
            ? new List<ContaPagar>()
            : (await GerenciadorContasPagar.ListarAsync(new FiltroContasPagar(FornecedorId: modelo.FornecedorId))).ToList();
    }

    private async Task SalvarAsync()
    {
        erro = null;
        var input = new BoletoInput(
            modelo.FornecedorId,
            modelo.ContaPagarId,
            modelo.Numero,
            modelo.LinhaDigitavel,
            modelo.CodigoBarras,
            modelo.Valor,
            DateOnly.FromDateTime(modelo.Vencimento),
            modelo.DataPagamento is null ? null : DateOnly.FromDateTime(modelo.DataPagamento.Value),
            modelo.Banco,
            modelo.Status,
            modelo.Observacoes);

        if (editandoId is null)
        {
            // Cria e mantém o modal aberto — mesmo raciocínio de
            // NotasFiscais.razor: deixa anexar o PDF na hora, sem fechar e
            // reabrir em "Editar".
            var criacao = await Gerenciador.CriarAsync(input, usuarioId);
            if (!criacao.Operacao.Sucesso || criacao.Entidade is null)
            {
                erro = string.Join("; ", criacao.Operacao.Erros);
                return;
            }

            editandoId = criacao.Entidade.Id;
            recemCriado = true;
        }
        else
        {
            var resultado = await Gerenciador.EditarAsync(editandoId.Value, input, usuarioId);
            if (!resultado.Sucesso)
            {
                erro = string.Join("; ", resultado.Erros);
                return;
            }

            formularioAberto = false;
        }

        await BuscarAsync();
    }

    private async Task ExcluirAsync(Guid id)
    {
        await Gerenciador.ExcluirAsync(id, usuarioId);
        await BuscarAsync();
    }

    private static string RotuloStatus(StatusBoleto status) => status switch
    {
        StatusBoleto.EmAberto => "Em aberto",
        StatusBoleto.Pago => "Pago",
        StatusBoleto.Vencido => "Vencido",
        StatusBoleto.Cancelado => "Cancelado",
        _ => status.ToString(),
    };

    private static string ClasseStatus(StatusBoleto status) => status switch
    {
        StatusBoleto.EmAberto => "text-bg-secondary",
        StatusBoleto.Pago => "text-bg-success",
        StatusBoleto.Vencido => "text-bg-danger",
        StatusBoleto.Cancelado => "text-bg-dark",
        _ => "text-bg-secondary",
    };

    private sealed class Modelo
    {
        public Guid FornecedorId { get; set; }

        public Guid ContaPagarId { get; set; }

        [Required(ErrorMessage = "Informe o número.")]
        public string Numero { get; set; } = "";

        [Required(ErrorMessage = "Informe a linha digitável.")]
        public string LinhaDigitavel { get; set; } = "";

        public string? CodigoBarras { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "Valor não pode ser negativo.")]
        public decimal Valor { get; set; }

        public DateTime Vencimento { get; set; } = DateTime.Today;

        public DateTime? DataPagamento { get; set; }

        public string? Banco { get; set; }

        public StatusBoleto Status { get; set; } = StatusBoleto.EmAberto;

        public string? Observacoes { get; set; }
    }
}
